{
  "manifest_version": 3,
  "name": "Fotolog para Instagram",
  "version": "2.3.2",
  "description": "Tu Instagram como Fotolog: fotos y reels en el diario, miniaturas, colores por usuario y libro de visitas.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fotolog para Instagram",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "config.js",
        "runtime.js",
        "content.js"
      ],
      "css": [
        "skin.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
